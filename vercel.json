{
  "buildCommand": "pnpm --filter @workspace/shamim-forever run build",
  "outputDirectory": "artifacts/shamim-forever/dist",
  "installCommand": "pnpm install",
  "framework": null,
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    }
  ],
  "env": {
    "VITE_API_BASE_URL": "https://shamimforever.vercel.app"
  }
}
